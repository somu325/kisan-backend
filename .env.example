# Application Settings
PROJECT_NAME="Kisan Backend"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"
API_V1_STR="/api/v1"
HOST="0.0.0.0"
PORT=8000

# CORS (comma-separated list or JSON array of allowed origins)
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]

# PostgreSQL Database (Asyncpg)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=kisan_db
# Set explicitly or dynamically computed in config.py:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kisan_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# REDIS_URL=redis://localhost:6379/0

# External APIs & LLM Placeholders (Ready for next phases)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
